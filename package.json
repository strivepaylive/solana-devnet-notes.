{
  "name": "momentum-solana-safety",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create momentum-db",
    "db:local": "wrangler d1 execute momentum-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute momentum-db --remote --file=./schema.sql",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {"wrangler":"^4.45.0"}
}
